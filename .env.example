# Server
PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/alzafar

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"

# AWS S3 / Media Storage
AWS_S3_REGION=eu-west-2
AWS_S3_ACCESS_KEY=your-access-key
AWS_S3_SECRET_KEY=your-secret-key
AWS_S3_BUCKET=alzafar-media

# Email (SMTP)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=apikey
MAIL_PASS=your-smtp-password
MAIL_FROM="Al-Zafar Team <noreply@alzafar.com>"
